ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Leave empty to use a local SQLite file (data/job_hunter.db) -- fine for
# solo local use. Set this (a Postgres connection string, e.g. from a free
# Supabase project: Project Settings -> Database -> Connection string ->
# URI) so the locally-scheduled scraper and a cloud-hosted dashboard share
# one live database.
DATABASE_URL=

# Optional: restrict Greenhouse/Comeet scraping to specific company board tokens
# (comma separated). Leave empty to skip that source.
GREENHOUSE_BOARD_TOKENS=
COMEET_COMPANY_UIDS=

# Optional: RSS/Google Alerts feed URLs to ingest (comma separated)
RSS_FEED_URLS=
